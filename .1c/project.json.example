{
  "name": "example-config",
  "platformVersion": "8.3.23.1865",
  "designer": "",
  "src": "src",
  "template": {
    "name": "1c-agent-designer",
    "version": "2026.07.27",
    "url": "https://github.com/HEOcanuAHT/1c-agent-designer.git",
    "ref": "main"
  },
  "infobase": {
    "type": "file",
    "path": ".1c/ib-dev"
  },
  "auth": {
    "required": true,
    "user": "",
    "password": ""
  },
  "ext": {
    "dir": "src/_extDataProcessors",
    "artifacts": "artifacts/ext"
  },
  "designerAgent": {
    "host": "127.0.0.1",
    "port": 1543,
    "listenAddress": "127.0.0.1",
    "baseDir": ".",
    "visible": true,
    "autoStart": true,
    "keepAlive": false,
    "startupWaitSec": 25,
    "format": "hierarchical",
    "sshClient": "auto",
    "transport": "agent",
    "delta": {
      "baseRef": "main",
      "headRef": "HEAD"
    }
  }
}
