{
  "name": "example-config",
  "platformVersion": "8.3.23.1865",
  "designer": "",
  "src": "src",
  "template": {
    "name": "1c-agent-designer",
    "version": "2026.07.31.2",
    "url": "https://github.com/HEOcanuAHT/1c-agent-designer.git",
    "ref": "main"
  },
  "tools": {
    "preferredDump": "ibcmd"
  },
  "infobase": {
    "type": "ibname",
    "name": "My Base (from 1C list)",
    "dbms": {
      "kind": "MSSQLServer",
      "server": "sql-host",
      "name": "db_name",
      "windowsAuth": true
    }
  },
  "ibcmd": {
    "dataDir": ".1c/ibcmd-data",
    "stagingDir": ".1c/ibcmd-dump-staging",
    "parkDir": ".1c/ibcmd-dump-park",
    "preservePaths": []
  },
  "auth": {
    "required": true,
    "credentialTarget": "1c-ib/example-config"
  },
  "ext": {
    "dir": "src/_extDataProcessors",
    "artifacts": "artifacts/ext",
    "serviceIb": {
      "enabled": true,
      "dbPath": ".1c/ib-ext",
      "dataDir": ".1c/ib-ext-data"
    }
  },
  "cfe": {
    "dir": "src/_extensions",
    "artifacts": "artifacts/cfe"
  },
  "designerAgent": {
    "host": "127.0.0.1",
    "port": 1543,
    "listenAddress": "127.0.0.1",
    "baseDir": ".",
    "visible": true,
    "autoStart": true,
    "keepAlive": false,
    "startupWaitSec": 25,
    "format": "hierarchical",
    "sshClient": "auto",
    "transport": "agent",
    "delta": {
      "baseRef": "main",
      "headRef": "HEAD"
    }
  }
}
