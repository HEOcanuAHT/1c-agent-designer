{
  "name": "example-config",
  "platformVersion": "8.3.23.1865",
  "ibcmd": "",
  "src": "src",
  "artifacts": "artifacts",
  "infobase": {
    "type": "file",
    "path": ".1c/ib-pack",
    "createIfMissing": true,
    "dbms": {
      "kind": "MSSQLServer",
      "server": "sql-host",
      "name": "db_name",
      "windowsAuth": true
    }
  },
  "auth": {
    "required": false
  },
  "pack": {
    "cfName": "example-config.cf",
    "force": true,
    "apply": true
  },
  "delta": {
    "useTemp": true,
    "purgeOnFinish": true,
    "baseRef": "HEAD~1",
    "headRef": "HEAD",
    "cfName": "example-config-delta.cf",
    "infobase": {
      "path": ".1c/ib-pack-delta",
      "createIfMissing": true
    }
  }
}
