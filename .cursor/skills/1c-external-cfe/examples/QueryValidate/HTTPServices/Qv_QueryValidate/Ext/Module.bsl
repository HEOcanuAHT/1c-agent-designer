// Служебный HTTP-сервис проверки языка запросов 1С (без выполнения).
// POST /hs/qv/validate  — тело: JSON {"query":"..."} / {"querytext":"..."} или text/plain
// GET  /hs/qv/health    — liveness

#Область ОбработчикиHTTP

Функция HealthGet(Запрос)
	
	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Результат.Вставить("service", "QueryValidate");
	Результат.Вставить("version", "1.0.0");
	Возврат ОтветJSON(Результат, 200);
	
КонецФункции

Функция ValidatePost(Запрос)
	
	ТекстЗапроса = ИзвлечьТекстЗапроса(Запрос);
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Возврат ОтветОшибка(400, "query is required (JSON field query/querytext or text/plain body)");
	КонецЕсли;
	
	Ошибка = ПроверитьТекстЗапроса(ТекстЗапроса);
	
	Результат = Новый Структура;
	Результат.Вставить("ok", Истина);
	Если ПустаяСтрока(Ошибка) Тогда
		Результат.Вставить("valid", Истина);
		Результат.Вставить("error", "");
		Возврат ОтветJSON(Результат, 200);
	Иначе
		Результат.Вставить("valid", Ложь);
		Результат.Вставить("error", Ошибка);
		Возврат ОтветJSON(Результат, 200);
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИзвлечьТекстЗапроса(Запрос)
	
	Тело = Запрос.ПолучитьТелоКакСтроку();
	Если Не ЗначениеЗаполнено(Тело) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстJSON = СокрЛП(Тело);
	Если СтрНачинаетсяС(ТекстJSON, "{") Тогда
		Попытка
			Данные = ПрочитатьЗначениеJSON(ТекстJSON);
			Если ТипЗнч(Данные) = Тип("Структура") Тогда
				Значение = Неопределено;
				Если Данные.Свойство("query", Значение) И ЗначениеЗаполнено(Значение) Тогда
					Возврат Строка(Значение);
				КонецЕсли;
				Если Данные.Свойство("querytext", Значение) И ЗначениеЗаполнено(Значение) Тогда
					Возврат Строка(Значение);
				КонецЕсли;
				Если Данные.Свойство("ТекстЗапроса", Значение) И ЗначениеЗаполнено(Значение) Тогда
					Возврат Строка(Значение);
				КонецЕсли;
			КонецЕсли;
		Исключение
			// не JSON — считаем сырым текстом запроса
		КонецПопытки;
	КонецЕсли;
	
	Возврат Тело;
	
КонецФункции

// Проверка без выполнения: СхемаЗапроса + НайтиПараметры (как comol validatequery).
// Пустая строка = ок; иначе текст ошибки платформы.
Функция ПроверитьТекстЗапроса(ТекстЗапроса)
	
	Попытка
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
		СхемаЗапроса.ПолучитьТекстЗапроса();
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Попытка
		ЗапросПроверки = Новый Запрос;
		ЗапросПроверки.Текст = ТекстЗапроса;
		ЗапросПроверки.НайтиПараметры();
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

Функция ОтветJSON(Данные, КодСостояния = 200)
	
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ЗаписатьЗначениеJSON(Данные), КодировкаТекста.UTF8);
	Возврат Ответ;
	
КонецФункции

Функция ОтветОшибка(КодСостояния, ТекстОшибки)
	
	Результат = Новый Структура;
	Результат.Вставить("ok", Ложь);
	Результат.Вставить("valid", Ложь);
	Результат.Вставить("error", ТекстОшибки);
	Возврат ОтветJSON(Результат, КодСостояния);
	
КонецФункции

Функция ПрочитатьЗначениеJSON(СтрокаJSON)
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Данные = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Возврат Данные;
	
КонецФункции

Функция ЗаписатьЗначениеJSON(Значение)
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
	
КонецФункции

#КонецОбласти
